# Local-only example. Never commit real credentials.
ConnectionStrings__Identity=Host=127.0.0.1;Port=5432;Database=agropecuaria;Username=agropecuaria;Password=local-development-only
Identity__DevelopmentProvider__Enabled=true
# Leave these empty locally. Inject real values from the test server secret store.
Identity__Oidc__Authority=
Identity__Oidc__ClientId=
Identity__Oidc__ClientSecret=
Identity__Oidc__EmailEnabled=true
Identity__Oidc__GoogleEnabled=true
AGRO_API_ORIGIN=http://127.0.0.1:5080
