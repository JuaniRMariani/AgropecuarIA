{
  "Identity": {
    "ApplyMigrations": false,
    "Oidc": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "EmailConnection": "email",
      "GoogleConnection": "google-oauth2",
      "EmailEnabled": true,
      "GoogleEnabled": true
    },
    "DevelopmentProvider": {
      "Enabled": false
    },
    "StrongAuthentication": {
      "Enabled": false
    },
    "Runtime": {
      "SessionLifetime": "12:00:00",
      "LinkAttemptLifetime": "00:10:00",
      "StepUpAttemptLifetime": "00:05:00",
      "StrongAuthenticationWindow": "00:05:00",
      "RecentAuthenticationWindow": "00:15:00"
    },
    "RateLimits": {
      "PerIpPerMinute": 120,
      "PerSessionPerMinute": 30,
      "StepUpPerSessionPerFiveMinutes": 5
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "AllowedHosts": "*"
}
