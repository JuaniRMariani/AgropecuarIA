{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agropecuaria.example/contracts/identity/effective-context.v1.schema.json",
  "title": "Effective access context v1",
  "oneOf": [
    { "$ref": "#/$defs/signedOut" },
    { "$ref": "#/$defs/selectionRequired" },
    { "$ref": "#/$defs/active" },
    { "$ref": "#/$defs/revoked" }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "userId", "assurance", "methods", "authenticatedAt"],
      "properties": {
        "kind": { "const": "human" },
        "userId": { "$ref": "#/$defs/uuid" },
        "assurance": {
          "enum": ["aal1", "aal2", "phishing-resistant"]
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["oidc", "passkey", "totp", "recovery"] }
        },
        "authenticatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "membershipId", "displayName", "membershipStatus"],
      "properties": {
        "organizationId": { "$ref": "#/$defs/uuid" },
        "membershipId": { "$ref": "#/$defs/uuid" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "membershipStatus": { "enum": ["active", "suspended", "revoked"] }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "expiresAt", "stepUpExpiresAt"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/uuid" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "stepUpExpiresAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "signedOut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "signed_out" } }
    },
    "selectionRequired": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actor", "organizations", "session"],
      "properties": {
        "kind": { "const": "selection_required" },
        "actor": { "$ref": "#/$defs/actor" },
        "organizations": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/organization" }
        },
        "session": { "$ref": "#/$defs/session" }
      }
    },
    "active": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actor", "tenant", "permissions", "authorizationVersion", "session"],
      "properties": {
        "kind": { "const": "active" },
        "actor": { "$ref": "#/$defs/actor" },
        "tenant": { "$ref": "#/$defs/organization" },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$" }
        },
        "authorizationVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
        "session": { "$ref": "#/$defs/session" }
      }
    },
    "revoked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": { "const": "revoked" },
        "reason": { "enum": ["membership_revoked", "session_revoked", "security_version_changed"] }
      }
    }
  }
}
