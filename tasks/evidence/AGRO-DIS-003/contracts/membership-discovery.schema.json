{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agropecuaria.example/contracts/identity/membership-discovery.v1.schema.json",
  "title": "Actor-scoped membership discovery v1",
  "description": "Internal server-side discovery result. The authenticated actor is derived from the session and is never accepted in the request contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "memberships"],
  "properties": {
    "kind": { "const": "membership_discovery" },
    "memberships": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "membershipId",
          "organizationId",
          "displayName",
          "membershipStatus",
          "authorizationVersion"
        ],
        "properties": {
          "membershipId": { "type": "string", "format": "uuid" },
          "organizationId": { "type": "string", "format": "uuid" },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
          "membershipStatus": { "const": "active" },
          "authorizationVersion": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
