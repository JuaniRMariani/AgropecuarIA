{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agropecuaria.local/contracts/discovery/cap-lifecycle.v1.schema.json",
  "title": "CapLifecycleEventV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "sender", "identifier", "sent", "messageType", "status", "scope", "effective", "expires", "references", "areas", "lifecycleState", "sourceHash"],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "sender": { "type": "string", "minLength": 1 },
    "identifier": { "type": "string", "minLength": 1 },
    "sent": { "type": "string", "format": "date-time" },
    "messageType": { "enum": ["Alert", "Update", "Cancel"] },
    "status": { "enum": ["Actual", "Exercise", "System", "Test", "Draft"] },
    "scope": { "enum": ["Public", "Restricted", "Private"] },
    "effective": { "type": "string", "format": "date-time" },
    "expires": { "type": "string", "format": "date-time" },
    "references": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "polygons"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "polygons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["longitude", "latitude"],
                "properties": {
                  "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
                  "latitude": { "type": "number", "minimum": -90, "maximum": 90 }
                }
              }
            }
          }
        }
      }
    },
    "lifecycleState": { "enum": ["active", "updated", "cancelled", "expired"] },
    "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
