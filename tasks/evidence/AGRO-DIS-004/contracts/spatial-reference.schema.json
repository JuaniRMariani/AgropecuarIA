{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agropecuaria.local/contracts/discovery/spatial-reference.v1.schema.json",
  "title": "SpatialReferenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "crs", "axisOrder", "geometryType", "geometry", "limits", "calculatedArea", "validity"],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "crs": { "const": "EPSG:4326" },
    "axisOrder": { "const": "longitude-latitude" },
    "geometryType": { "enum": ["Polygon", "MultiPolygon"] },
    "geometry": { "type": "object" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payloadBytes", "vertexCount", "maxPayloadBytes", "maxVertexCount"],
      "properties": {
        "payloadBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "vertexCount": { "type": "integer", "minimum": 4, "maximum": 10000 },
        "maxPayloadBytes": { "const": 1048576 },
        "maxVertexCount": { "const": 10000 }
      }
    },
    "declaredArea": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["value", "unit", "source"],
      "properties": {
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["ha", "m2"] },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "calculatedArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["squareMeters", "hectares", "method"],
      "properties": {
        "squareMeters": { "type": "number", "minimum": 0 },
        "hectares": { "type": "number", "minimum": 0 },
        "method": { "const": "postgis-geography-spheroid" },
        "equalAreaControlRelativeDelta": { "type": "number", "minimum": 0, "maximum": 0.005 }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isValid"],
      "properties": {
        "isValid": { "type": "boolean" },
        "reason": { "type": ["string", "null"] }
      }
    }
  }
}
