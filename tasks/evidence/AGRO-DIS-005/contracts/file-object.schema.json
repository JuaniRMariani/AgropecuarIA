{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agropecuaria.local/contracts/storage/file-object-v1.schema.json",
  "title": "FileObjectV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fileId", "tenantRef", "version", "displayName", "declaredMediaType", "state", "classification", "linkedResource", "legalHold", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "fileId": { "type": "string", "format": "uuid" },
    "tenantRef": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "version": { "type": "integer", "minimum": 1 },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 180 },
    "declaredMediaType": { "enum": ["application/pdf", "image/jpeg", "image/png"] },
    "detectedMediaType": { "enum": ["application/pdf", "image/jpeg", "image/png"] },
    "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 10485760 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "state": { "enum": ["pending_upload", "uploaded", "scanning", "available", "quarantined", "rejected", "scan_failed", "purging", "purge_uncertain", "deleted"] },
    "classification": { "enum": ["public", "internal", "confidential", "fiscal_personal"] },
    "linkedResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": { "type": { "type": "string", "minLength": 1 }, "id": { "type": "string", "format": "uuid" } }
    },
    "legalHold": { "type": "boolean" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "enum": ["uploaded", "scanning", "available", "quarantined", "rejected", "scan_failed", "purging", "purge_uncertain", "deleted"] } } },
      "then": {
        "properties": {
          "detectedMediaType": {},
          "sizeBytes": {},
          "sha256": {}
        },
        "required": ["detectedMediaType", "sizeBytes", "sha256"]
      }
    }
  ]
}
