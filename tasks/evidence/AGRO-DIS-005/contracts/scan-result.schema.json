{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agropecuaria.local/contracts/storage/scan-result-v1.schema.json",
  "title": "ScanResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fileId", "version", "sequence", "sha256", "verdict", "scannerRef", "scannedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "fileId": { "type": "string", "format": "uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "verdict": { "enum": ["clean", "threat", "unsupported", "access_denied", "failed"] },
    "scannerRef": { "type": "string", "minLength": 1, "maxLength": 80 },
    "scannedAt": { "type": "string", "format": "date-time" }
  }
}
