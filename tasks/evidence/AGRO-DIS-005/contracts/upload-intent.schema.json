{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agropecuaria.local/contracts/storage/upload-intent-v1.schema.json",
  "title": "UploadIntentV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fileId", "version", "uploadToken", "expiresAt", "maxBytes", "allowedMediaTypes"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "fileId": { "type": "string", "format": "uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "uploadToken": { "type": "string", "minLength": 32 },
    "expiresAt": { "type": "string", "format": "date-time" },
    "maxBytes": { "type": "integer", "minimum": 1, "maximum": 10485760 },
    "allowedMediaTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["application/pdf", "image/jpeg", "image/png"] } }
  }
}
