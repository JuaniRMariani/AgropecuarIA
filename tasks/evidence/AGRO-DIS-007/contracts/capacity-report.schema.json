{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agropecuaria.local/contracts/discovery/capacity-report-1.0.schema.json",
  "title": "Capacity planning projection report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarioId", "classification", "generatedAt", "projection", "slo", "cost"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "scenarioId": { "type": "string", "minLength": 1 },
    "classification": { "const": "synthetic-estimate" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["averageRequestsPerSecond", "peakRequestsPerSecond", "retainedObjectGiB", "dailyImportDrainSeconds"],
      "properties": {
        "averageRequestsPerSecond": { "type": "number", "minimum": 0 },
        "peakRequestsPerSecond": { "type": "number", "minimum": 0 },
        "retainedObjectGiB": { "type": "number", "minimum": 0 },
        "dailyImportDrainSeconds": { "type": "number", "minimum": 0 }
      }
    },
    "slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availabilityTarget", "windowDays", "errorBudgetSeconds", "badEventsPerMillion"],
      "properties": {
        "availabilityTarget": { "const": 0.999 },
        "windowDays": { "const": 30 },
        "errorBudgetSeconds": { "type": "number", "minimum": 0 },
        "badEventsPerMillion": { "type": "integer", "minimum": 0 }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "currency", "missingDrivers"],
      "properties": {
        "status": { "enum": ["incomplete", "estimated"] },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "low": { "type": "number", "minimum": 0 },
        "base": { "type": "number", "minimum": 0 },
        "high": { "type": "number", "minimum": 0 },
        "missingDrivers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "estimated" } } },
          "then": {
            "required": ["low", "base", "high"],
            "properties": {
              "low": { "type": "number", "minimum": 0 },
              "base": { "type": "number", "minimum": 0 },
              "high": { "type": "number", "minimum": 0 },
              "missingDrivers": { "type": "array", "maxItems": 0 }
            }
          },
          "else": { "properties": { "missingDrivers": { "type": "array", "minItems": 1 } } }
        }
      ]
    }
  }
}
