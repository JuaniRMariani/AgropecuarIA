      "format": "uuid"
    },
    "managementUnitId": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 2
    },
    "changedAtUtc": {
      "type": "string",
      "format": "date-time"
    }
  }
}
