{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agropecuaria.local/contracts/national-catalog/product-catalog-published.v1.schema.json",
  "title": "ProductCatalogPublished v1 payload",
  "description": "Local platform publication activation; source lineage and candidate precondition are not professional approval. No external dispatcher is asserted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["versionId", "versionTag", "previousActiveVersionId", "itemsCount", "candidateHash", "sourceSnapshotIds", "publishedAtUtc"],
  "properties": {
    "versionId": {"type": "string", "format": "uuid"},
    "versionTag": {"type": "string", "minLength": 1, "maxLength": 64},
    "previousActiveVersionId": {"type": ["string", "null"], "format": "uuid"},
    "itemsCount": {"type": "integer", "minimum": 1, "maximum": 50000},
    "candidateHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceSnapshotIds": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "publishedAtUtc": {"type": "string", "format": "date-time"}
  }
}
