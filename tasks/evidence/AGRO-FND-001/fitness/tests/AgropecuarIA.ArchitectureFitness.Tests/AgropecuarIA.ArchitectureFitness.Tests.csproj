<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AgropecuarIA.ArchitectureFitness\AgropecuarIA.ArchitectureFitness.csproj" />
    <ProjectReference Include="..\..\..\..\..\..\src\AgropecuarIA.Identity\AgropecuarIA.Identity.csproj" />
    <ProjectReference Include="..\..\..\..\..\..\src\AgropecuarIA.ProductiveCore\AgropecuarIA.ProductiveCore.csproj" />
    <ProjectReference Include="..\..\..\..\..\..\src\AgropecuarIA.Territory\AgropecuarIA.Territory.csproj" />
    <ProjectReference Include="..\..\..\..\..\..\src\AgropecuarIA.Catalog\AgropecuarIA.Catalog.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\module-boundaries.json" Link="evidence\module-boundaries.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\consumer-map.json" Link="evidence\consumer-map.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\runtime-map.json" Link="evidence\runtime-map.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\contracts\*.json" Link="evidence\contracts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\fixtures\**\*.json" Link="evidence\fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\..\..\contracts\identity.openapi.yaml" Link="evidence\contracts\identity.openapi.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\..\..\contracts\territory.openapi.yaml" Link="evidence\contracts\territory.openapi.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\..\..\contracts\productive-core.openapi.yaml" Link="evidence\contracts\productive-core.openapi.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\..\..\contracts\catalog.openapi.yaml" Link="evidence\contracts\catalog.openapi.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
